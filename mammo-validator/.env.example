# Copy to `.env` and adjust. All values are optional for the local demo.

# Python interpreter to launch the prediction worker (used by /api/predict).
# Defaults to `python` / `python3`.
MAMMO_PYTHON=

# Location of the 4-fold PyTorch + CatBoost checkpoints (used by /api/predict).
MAMMO_MODELS_DIR=

# Path of the local SQLite database for the multi-user backend.
# Defaults to <app>/data/mammoqa.db
MAMMO_DB_PATH=

# HMAC signing secret for session cookies.
# REQUIRED in production: if unset, the app refuses to start. Generate one
# with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# For local development only, a fixed built-in fallback is used when omitted.
MAMMO_AUTH_SECRET=